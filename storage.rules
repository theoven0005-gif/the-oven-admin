rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }

    // Customer payment screenshots (online transfers).
    match /paymentProofs/{customerId}/{fileName} {
      allow read: if admin() || (signedIn() && customerId == request.auth.uid);
      allow write: if signedIn() && customerId == request.auth.uid && request.resource.size < 5 * 1024 * 1024;
    }

    // Menu item photos uploaded by admins (max 5 MB, images only).
    match /menu/{fileName} {
      allow read: if signedIn();
      allow write: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Promotional banner images uploaded by admins.
    match /banners/{fileName} {
      allow read: if signedIn();
      allow write: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
